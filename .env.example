# ais-its-safety-service — every variable the service reads (docs/PLATFORM_SPEC.md §4).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=safety
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3011
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000

# --- PostgreSQL (TimescaleDB + PostGIS), schema "safety" ---------------------
DATABASE_URL=postgres://safety_svc:safety_svc@localhost:5432/aisits
DATABASE_SCHEMA=safety
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream --------------------------------------------------------------
# Comma separated list allowed.
NATS_URL=nats://localhost:4222
# Prefix of every durable consumer name: empty in deployments (test suites set one).
NATS_DURABLE_PREFIX=

# --- Valkey ----------------------------------------------------------------------
# Not used: this service imports no RedisModule (detector state lives in memory).
# REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (routes marked @AllowApiKey).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
# Proxies whose X-Forwarded-* headers are trusted (set the gateway's address/CIDR in production).
TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# --- Tracing (OTLP/HTTP; disabled when unset) --------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Safety state publication (spec §13.7) ----------------------------------------
# Longest interval (event time, s) between two safety.vessel_state.updated.v1 of a vessel
# whose state did not change; a change publishes at once.
SAFETY_STATE_HEARTBEAT_S=300
# How often the detectors' pending vessel states are written to vessel_state and published, ms.
SAFETY_STATE_FLUSH_MS=250

# --- Detector runner (Detector SDK, spec §18) ---------------------------------------
# Positions handled in parallel (one vessel's positions stay ordered).
DETECTOR_CONCURRENCY=8
# AlertEmitter cooldown: a key going back to an already published severity (or re-raised
# after its resolution) within this many seconds is not published again.
ALERT_COOLDOWN_S=600
# How long startup waits for the GEO / FLEET snapshots (runner and projection rebuild), ms.
PROJECTION_CATCH_UP_TIMEOUT_MS=60000

# --- Detectors ----------------------------------------------------------------------
# Comma separated detector ids run by this instance; empty = all (ews,collision). A subset
# consumes AIS_POSITION through its own durable (safety-positions-<ids>), so each detector
# can be deployed separately (README "Deployment").
DETECTORS=ews,collision

# ews — pipeline Early Warning System (legacy checkShipStatus parity, method
# ews.pipeline_distance_status): a vessel predicted at anchor closer than EWS_DANGER_M to an
# active pipeline zone line is in danger (critical alert), closer than EWS_WARNING_M warned.
EWS_DANGER_M=500
EWS_WARNING_M=1750

# collision — CPA/TCPA risk between vessel pairs (method collision.cpa_tcpa). Every value is a
# v2 design default that needs domain validation; bands must grow from high to low.
# Candidates within this radius around a moving vessel, nm.
COLLISION_SEARCH_RADIUS_NM=6
# Candidates must have been seen within this window of the position, s (at most 600).
COLLISION_MAX_AGE_S=120
# Vessels slower than this are not assessed, knots.
COLLISION_MIN_SOG_KN=0.5
# high (critical alert): CPA < HIGH_CPA_NM and 0 <= TCPA < HIGH_TCPA_MIN.
COLLISION_HIGH_CPA_NM=0.25
COLLISION_HIGH_TCPA_MIN=6
# medium (warning alert): CPA < MEDIUM_CPA_NM and 0 <= TCPA < MEDIUM_TCPA_MIN.
COLLISION_MEDIUM_CPA_NM=0.5
COLLISION_MEDIUM_TCPA_MIN=12
# low (state only, no alert): CPA < LOW_CPA_NM and 0 <= TCPA < LOW_TCPA_MIN.
COLLISION_LOW_CPA_NM=1
COLLISION_LOW_TCPA_MIN=20
# A pair keeps its band until it leaves the band's limits widened by this fraction.
COLLISION_HYSTERESIS=0.2
# Minimum interval between two stored samples of an unchanged encounter, s (0 = every evaluation).
COLLISION_SAMPLE_INTERVAL_S=30
